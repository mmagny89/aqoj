# Variables Docker Compose — lues uniquement par Docker Compose
# (conventions, section 3). Committe, sans secret. Genere par
# .claude/scripts/setup-symfony.sh le 2026-10-09.
#
# En staging et production, remplace (pas complete) par --env-file
# .env.staging.local / .env.prod.local, qui portent toutes les cles.

COMPOSE_FILE=compose.yml:compose.dev.yml

# Suffixe des noms visibles — conteneurs, reseau, volumes (section 2).
# Il permet a la PPD et a la production de cohabiter sur un meme hote
# sans partager ni conteneur ni volume. Les fichiers de secrets le
# redefinissent a staging et prod.
ENV=dev

# Versions d'images — verifiees aupres des registres le 2026-10-09.
PHP_VERSION=8.5.12
FRANKENPHP_VERSION=1.13.3
PHP_EXTENSION_INSTALLER_VERSION=2.12.0
POSTGRES_VERSION=18
# Attrapeur d'emails de developpement (section 8b).
MAILPIT_VERSION=1.31.4
NODE_VERSION=26-bookworm
API_PREFIX=/api

# Stage du Dockerfile PHP construit par un "docker compose -f compose.yml
# build" autonome ; les overrides figent target:/image: en dur.
TARGET=dev

# UID/GID de l'hote (section 6) — machine de generation.
USER_ID=501
GROUP_ID=20

# Xdebug — jamais fige au build (section 13).
XDEBUG_MODE=off

# Ports (section 4) — valeurs fixes, jamais deduites de l'hote.
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
POSTGRES_PORT=5432
# Interface web de l'attrapeur d'emails. Son port SMTP (1025) reste interne.
MAILPIT_PORT=8025

# Emails (section 8b). En developpement tout part vers Mailpit, qui les retient
# et les affiche ; rien ne quitte la machine. Staging et production portent leur
# propre valeur dans leur fichier de secrets, ce fichier n'y etant pas lu.
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@localhost

# Proxies de confiance (section 4). Vide en developpement : rien ne s'interpose,
# et faire confiance a des en-tetes que personne ne pose les rendrait
# falsifiables. En staging et en production : private_ranges.
SYMFONY_TRUSTED_PROXIES=
NODE_PORT=5173
# Scrutation des fichiers par Vite : sur un bind mount macOS ou Windows, les
# evenements du systeme de fichiers ne remontent pas toujours, et Vite sert
# alors une version perimee d'un module (page blanche apres un changement
# de branche). Un peu plus de CPU, aucun module rate.
VITE_USE_POLLING=1

# Mise a jour de schema au demarrage (section 8) — active en dev.
RUN_MIGRATIONS=1

# PostgreSQL — developpement uniquement.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!

# Tâches BGG planifiées par le service `worker` : cron à cinq champs, heure de Paris.
# Par l'environnement parce que la préproduction et la production partagent le même
# jeton BGG et ne doivent pas l'appeler à la même heure.
BGG_RESYNC_CRON=0 1 * * *
BGG_PENDING_CRON=0 2 * * *
BGG_SYNC_NEW_CRON=0 3 * * *
BGG_IMPORT_CSV_CRON=0 4 * * *

# Destinataire des alertes d'échec de tâche planifiée. Lue par php et worker (${ALERT_EMAIL:?}) :
# sans elle, ils refusent de démarrer plutôt que de laisser un échec sans témoin.
ALERT_EMAIL=alerte@aqoj.test
