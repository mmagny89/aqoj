# =============================================================================
# Docker Compose — variables d'infrastructure
# =============================================================================
# Ce fichier est commité (valeurs vides = documentation des clés attendues).
# Les valeurs réelles sont dans .env.local (non commité, à créer localement).
#
# Pour démarrer :
#   cp .env .env.local          → remplir les valeurs
#   cp backend/.env backend/.env.local → remplir les valeurs Symfony
# =============================================================================

COMPOSE_PROJECT_NAME=

# ── Base de données (PostgreSQL) ──────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Caddy (reverse proxy) ─────────────────────────────────────────────────────
# Dev  : SERVER_NAME=http://:80        → HTTP, pas de TLS
# Prod : SERVER_NAME=mondomaine.fr     → HTTPS auto via Let's Encrypt
SERVER_NAME=
# Email pour les alertes Let's Encrypt (optionnel)
CADDY_EMAIL=