# =============================================================================
# Symfony — variables d'application
# =============================================================================
# Ce fichier est commité (valeurs vides = documentation des clés attendues).
# Les valeurs réelles sont dans app/.env.local (non commité).
#
# DATABASE_URL, MAILER_DSN et les autres variables d'infrastructure sont injectés par
# Docker Compose (.env à la racine) : ne pas les définir ici sauf comme repli hors Docker.
# Ne pas le définir ici sauf comme fallback hors-Docker.
# =============================================================================

APP_ENV=
APP_DEBUG=

# Générer un secret fort en production :
#   docker compose exec php php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=


# Token d'application BGG (obtenu après validation sur boardgamegeek.com)
BGG_TOKEN=

# Secret JWT — générer avec : docker compose exec php php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# Tâches BGG planifiées (heure de Paris), lues par le planificateur du service `worker`.
# La préproduction décale les siennes (compose.staging.yml) : elle partage le jeton BGG.
BGG_RESYNC_CRON='0 1 * * *'
BGG_PENDING_CRON='0 2 * * *'
BGG_SYNC_NEW_CRON='0 3 * * *'
BGG_IMPORT_CSV_CRON='0 4 * * *'
TRANSLATE_CRON='*/10 * * * *'

# Destinataire des alertes d'échec de tâche planifiée et expéditeur (surchargés par environnement).
ALERT_EMAIL=alerte@localhost
MAILER_FROM=noreply@localhost
