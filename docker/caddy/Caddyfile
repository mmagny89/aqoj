{
    admin off
    # Pour recevoir les alertes Let's Encrypt en prod, définir CADDY_EMAIL
    # dans le .env et décommenter la ligne suivante :
    # email {$CADDY_EMAIL}
}

# Dev  → SERVER_NAME=http://:80   (préfixe http:// = pas de TLS)
# Prod → SERVER_NAME=monsite.fr   (Caddy obtient un cert Let's Encrypt automatiquement
#                                   + redirige HTTP → HTTPS)
{$SERVER_NAME:http://:80} {

    # ── Headers de sécurité ──────────────────────────────────────────────────
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss:; img-src 'self' data:; font-src 'self'"
        -Server
    }

    # HSTS — envoyé uniquement sur les connexions HTTPS (ignoré en dev HTTP)
    @https protocol https
    header @https Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # ── API → Symfony ────────────────────────────────────────────────────────
    handle /api/* {
        reverse_proxy backend:8080
    }

    # ── Frontend ─────────────────────────────────────────────────────────────
    handle {
        reverse_proxy frontend:5173
    }
}
