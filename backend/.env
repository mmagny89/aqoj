# =============================================================================
# Symfony — variables d'application
# =============================================================================
# Ce fichier est commité (valeurs vides = documentation des clés attendues).
# Les valeurs réelles sont dans backend/.env.local (non commité).
#
# DATABASE_URL est injecté automatiquement par Docker Compose
# depuis les POSTGRES_* définis dans .env.local (racine).
# Ne pas le définir ici sauf comme fallback hors-Docker.
# =============================================================================

APP_ENV=
APP_DEBUG=

# Générer un secret fort en production :
#   docker compose exec backend php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# Origines CORS autorisées (regex)
CORS_ALLOW_ORIGIN=
