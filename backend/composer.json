{
    "name": "aqoj/backend",
    "description": "A quoi on joue — Backend API",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "nelmio/cors-bundle": "^2.5 || ^3.0",
        "symfony/console": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/framework-bundle": "8.0.*",
        "symfony/http-client": "^8.0",
        "symfony/property-access": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/serializer": "^8.0",
        "symfony/uid": "^8.0",
        "symfony/validator": "8.0.*",
        "symfony/yaml": "8.0.*"
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.62"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
