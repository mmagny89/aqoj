#!/usr/bin/env bash
# Hook pre-push : `make check` doit passer avant qu'un push parte. Contournement exceptionnel :
# SKIP_CHECKS=1 git push
if [ "${SKIP_CHECKS:-}" = "1" ]; then
	echo "pre-push : contrôles ignorés (SKIP_CHECKS=1)."
	exit 0
fi
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push : make check…"
make check || {
	echo "pre-push : un contrôle a échoué, le push est annulé." >&2
	exit 1
}
